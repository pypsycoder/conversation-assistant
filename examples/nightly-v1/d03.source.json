    {
      "id": "s4",
      "role": "patient",
      "text": "Не помню, было ли раньше.",
      "start": 3,
      "end": 4
    },
    {
      "id": "s5",
      "role": "doctor",
      "text": "Как давно работаете водителем?",
      "start": 4,
      "end": 5
    },
    {
      "id": "s6",
      "role": "patient",
      "text": "Идёт двадцатый год, полных девятнадцать лет.",
      "start": 5,
      "end": 6
    },
    {
      "id": "s7",
      "role": "doctor",
      "text": "Что жена замечает в вашем состоянии?",
      "start": 6,
      "end": 7
