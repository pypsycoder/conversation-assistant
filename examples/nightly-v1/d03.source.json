    {
      "id": "s1",
      "role": "doctor",
      "text": "Что беспокоит?",
      "start": 0,
      "end": 1
    },
    {
      "id": "s2",
      "role": "patient",
      "text": "Последнюю неделю трудно сосредоточиться на работе.",
      "start": 1,
      "end": 2
    },
    {
      "id": "s3",
      "role": "doctor",
      "text": "Было ли такое раньше?",
