  "segments": [
    {
      "id": "s1",
      "role": "doctor",
      "text": "Какое лечение было первым?",
      "start": 0,
      "end": 1
    },
    {
      "id": "s2",
      "role": "patient",
      "text": "В 2024 году сертралин 50 мг утром шесть недель, без заметного улучшения.",
      "start": 1,
      "end": 2
    },
    {
      "id": "s3",
      "role": "doctor",
      "text": "Что принимали позднее?",
      "start": 2,
      "end": 3
    },
    {
      "id": "s4",
      "role": "patient",
      "text": "С января 2025 года эсциталопрам 10 мг утром три месяца, тревога уменьшилась.",
      "start": 3,
      "end": 4
    },
    {
      "id": "s5",
      "role": "doctor",
      "text": "Принимаете ли сейчас препараты?",
      "start": 4,
      "end": 5
    },
    {
      "id": "s6",
      "role": "patient",
      "text": "Сейчас ничего не принимаю.",
      "start": 5,
      "end": 6
    },
    {
      "id": "s7",
      "role": "doctor",
      "text": "Как сейчас чувствуете себя?",
      "start": 6,
      "end": 7
    },
    {
      "id": "s8",
      "role": "patient",
      "text": "Тревожно каждый вечер. Каждый вечер тревожусь — это то же самое, не второй симптом.",
      "start": 7,
      "end": 8
