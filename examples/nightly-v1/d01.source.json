  "segments": [
    {
      "id": "s1",
      "role": "doctor",
      "text": "Что беспокоит сейчас?",
      "start": 0,
      "end": 1
    },
    {
      "id": "s2",
      "role": "patient",
      "text": "Три недели трудно заснуть, обычно засыпаю через два часа.",
      "start": 1,
      "end": 2
    },
    {
      "id": "s3",
      "role": "doctor",
      "text": "Бывают ли панические приступы?",
      "start": 2,
      "end": 3
    },
    {
      "id": "s4",
      "role": "patient",
      "text": "Нет, приступов паники не было.",
      "start": 3,
      "end": 4
    },
    {
      "id": "s5",
      "role": "doctor",
      "text": "Когда началось нарушение сна?",
      "start": 4,
      "end": 5
    },
    {
      "id": "s6",
      "role": "patient",
      "text": "Сначала сказал три недели, но поправлю: с 12 сентября, примерно два месяца.",
      "start": 5,
      "end": 6
    },
    {
      "id": "s7",
      "role": "doctor",
      "text": "Что известно о здоровье матери?",
      "start": 6,
      "end": 7
    },
    {
      "id": "s8",
      "role": "patient",
      "text": "Сестра говорит, что у мамы была депрессия, сам документов не видел.",
      "start": 7,
      "end": 8
    }
